#!/bin/bash

# omarchy:summary=Install the Omarchy Phone session onto this device.
# omarchy:args=[--dry-run|--apply] [--force]
# omarchy:examples=omarchy-phone-install --dry-run

# Dry run is the default. --apply is what writes, and it refuses to run on a
# machine whose device profile does not resolve unless --force is given: this
# replaces ~/.config/hypr/*.lua, and doing that to somebody's laptop because
# they ran the wrong command in the wrong checkout is not a recoverable
# surprise. Everything it replaces is backed up first regardless.

set -euo pipefail

OMARCHY_PHONE_PATH="${OMARCHY_PHONE_PATH:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR_DIR="$CONFIG_HOME/hypr"
SHELL_CONFIG="$CONFIG_HOME/omarchy/shell.json"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-phone/backup-$(date +%Y%m%d-%H%M%S)"

APPLY=0
FORCE=0
for arg in "$@"; do
  case $arg in
  --apply) APPLY=1 ;;
  --dry-run) APPLY=0 ;;
  --force) FORCE=1 ;;
  *)
    echo "Unknown option for omarchy-phone-install: $arg" >&2
    exit 1
    ;;
  esac
done

say() { if ((APPLY)); then printf '  %s\n' "$1"; else printf '  would %s\n' "$1"; fi; }
step() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# --- guard -------------------------------------------------------------------
if codename=$("$OMARCHY_PHONE_PATH/bin/omarchy-phone-device" 2>/dev/null); then
  echo "Device: $codename ($("$OMARCHY_PHONE_PATH/bin/omarchy-phone-device" --field DEVICE_NAME))"
else
  echo "No device profile matches this machine." >&2
  if ((APPLY)) && ! ((FORCE)); then
    cat >&2 <<'MSG'
Refusing to --apply: this replaces ~/.config/hypr/*.lua with a phone session,
and on a desktop or laptop that is not what you want. Re-run with --force if
you really mean it, or set the override that omarchy-phone-diagnose prints.
MSG
    exit 1
  fi
fi

((APPLY)) || echo "(dry run -- nothing will be written; pass --apply to install)"

# --- session modules ---------------------------------------------------------
step "Hyprland session"
if ((APPLY)); then
  mkdir -p "$BACKUP_DIR/hypr"
fi
for source in "$OMARCHY_PHONE_PATH"/config/hypr/*.lua; do
  name=$(basename "$source")
  target="$HYPR_DIR/$name"
  if [[ -f $target ]] && ! cmp -s "$source" "$target"; then
    say "back up $name to ${BACKUP_DIR#"$HOME"/}/hypr/"
    ((APPLY)) && cp -a "$target" "$BACKUP_DIR/hypr/$name"
  fi
  say "install $name"
  if ((APPLY)); then
    mkdir -p "$HYPR_DIR"
    cp -a "$source" "$target"
  fi
done

# --- shell plugins -----------------------------------------------------------
step "Shell plugins"
if ((APPLY)); then
  "$OMARCHY_PHONE_PATH/bin/omarchy-phone-plugins-link"
else
  for dir in "$OMARCHY_PHONE_PATH"/plugins/*/; do
    [[ -f "$dir/manifest.json" ]] || continue
    say "link $(basename "$dir") into $CONFIG_HOME/omarchy/plugins"
  done
fi

# --- shell config ------------------------------------------------------------
step "Shell config"
bar_id=$(jq -r '.id' "$OMARCHY_PHONE_PATH/plugins/phone-bar/manifest.json" 2>/dev/null || echo "")
# Every non-bar plugin has to be listed in plugins[] or the host never enables
# it; bar plugins are selected by bar.id instead. See NOTES.md.
mapfile -t overlay_ids < <(
  for manifest in "$OMARCHY_PHONE_PATH"/plugins/*/manifest.json; do
    jq -r 'select((.kinds // []) | index("bar") | not) | .id' "$manifest" 2>/dev/null
  done
)

ids_json=$(printf '%s\n' "${overlay_ids[@]}" | jq -Rc 'select(length>0)' | jq -sc .)

# Omarchy's idle service locks the session after idle.lock seconds (upstream
# default 300), and its lock asks for a typed password the phone cannot enter:
# the on-screen keyboard is a layer surface the session lock covers. So on the
# phone both idle steps are pushed out of reach. The service has no "off" of its own --
# 0 means "at once" -- so it is the largest delay its millisecond timer holds,
# about 23 days. This comes out again when the phone has a lock with its own
# PIN pad (NOTES.md). The screensaver goes too: it launches a desktop window.
# (The stay-awake marker does switch idle off, but it is the control centre's
# Stay Awake tile, and a tap would undo it; this has no off the user can undo.)
IDLE_NEVER=2000000

# Everything below edits shell.json with jq, and a jq that cannot parse it
# fails inside `&&` chains where set -e does not reach. Say so up front and stop,
# before the plan is printed as though it could be carried out.
if [[ -r $SHELL_CONFIG ]] && ! jq -e 'type == "object"' "$SHELL_CONFIG" >/dev/null 2>&1; then
  echo "  $SHELL_CONFIG is not a JSON object; fix or remove it, then run this again" >&2
  exit 1
fi

if [[ -r $SHELL_CONFIG ]]; then
  say "back up shell.json"
  say "set bar.id = $bar_id"
  for id in "${overlay_ids[@]}"; do
    [[ -n $id ]] && say "add $id to plugins[]"
  done
  mapfile -t stale_ids < <(
    jq -r --argjson ids "$ids_json" --arg bar "$bar_id" '(.plugins // [])[] | (.id // "")
      | select(startswith("dev.omarchyphone.")) | select(. as $id | $ids + [$bar] | index($id) | not)' "$SHELL_CONFIG"
  )
  for id in "${stale_ids[@]}"; do
    say "drop $id from plugins[] (no plugin in this checkout provides it)"
  done
  say "push idle.lock and idle.screensaver out to $IDLE_NEVER s (no auto-lock until the phone has a PIN-pad lock)"

  if ((APPLY)); then
    mkdir -p "$BACKUP_DIR"
    cp -a "$SHELL_CONFIG" "$BACKUP_DIR/shell.json"
    tmp=$(mktemp)
    # Ids of ours that no manifest in this checkout provides any more -- a
    # plugin since replaced, like phone-appgrid by phone-home -- are dropped,
    # so an upgrade does not leave the host chasing a plugin that is gone.
    # Duplicates by id are dropped keeping the first, in order; entries with no
    # id are not ours to judge and pass through untouched.
    jq --arg bar "$bar_id" --argjson ids "$ids_json" --argjson never "$IDLE_NEVER" '
      .bar.id = $bar
      | .idle = ((if (.idle | type) == "object" then .idle else {} end) + {lock: $never, screensaver: $never})
      | .plugins = ((if (.plugins | type) == "array" then .plugins else [] end)
          | map(select(((.id // "") | tostring | startswith("dev.omarchyphone.") | not)
              or ((.id) as $id | $ids + [$bar] | index($id))))
          | . + [$ids[] | {id: .}]
          | reduce .[] as $p ({seen: {}, out: []};
              if ($p | type) != "object" or ($p.id // null) == null then .out += [$p]
              elif .seen[$p.id | tostring] then .
              else .seen[$p.id | tostring] = true | .out += [$p] end)
          | .out)
    ' "$SHELL_CONFIG" >"$tmp" || { rm -f "$tmp"; echo "  could not update $SHELL_CONFIG" >&2; exit 1; }
    mv "$tmp" "$SHELL_CONFIG"
  fi
else
  # Omarchy's shell writes shell.json on its first run. Creating one here would
  # mean guessing at the rest of its contents.
  echo "  no $SHELL_CONFIG yet: start Omarchy's shell once, then run this again" >&2
fi

# --- home screen -------------------------------------------------------------
step "Home screen"
# phone-home reads its dock from this file and watches it for edits. A starter
# holding its built-in defaults gives it a file to watch from the first boot;
# one that already exists is the user's and is never touched.
DOCK_FILE="$CONFIG_HOME/omarchy-phone/dock"
if [[ -e $DOCK_FILE ]]; then
  echo "  keep ${DOCK_FILE#"$HOME"/} (already present)"
else
  say "write ${DOCK_FILE#"$HOME"/} with the default dock"
  if ((APPLY)); then
    mkdir -p "$(dirname "$DOCK_FILE")"
    cat >"$DOCK_FILE" <<'DOCK'
# Apps in the home screen's dock, one desktop id per line (with or without
# ".desktop"), left to right; at most four are shown. Save and the dock
# updates. An empty list means an empty dock.
chromium
foot
org.gnome.Nautilus
Google Messages
DOCK
  fi
fi

# --- system ------------------------------------------------------------------
step "System"
# Omarchy locks the session on every suspend (omarchy-sleep-lock.service), and
# a phone suspends more readily than a laptop: many report a flip cover's or a
# fold's hall sensor as a lid switch, which logind suspends on. A lock the phone
# cannot unlock (see "Shell config") must not come in that way either. Masked,
# not disabled, so Omarchy's own upgrade re-enabling its units leaves it off.
say "mask omarchy-sleep-lock.service (no lock on suspend until the phone lock exists)"
((APPLY)) && { systemctl --user mask omarchy-sleep-lock.service >/dev/null 2>&1 \
  || echo "  could not mask omarchy-sleep-lock.service; do it by hand" >&2; }
say "run install/hardware/power-key.sh (logind long-press -> poweroff)"
((APPLY)) && bash "$OMARCHY_PHONE_PATH/install/hardware/power-key.sh"

step "Done"
if ((APPLY)); then
  echo "  Backup: $BACKUP_DIR"
  echo "  Restart the session to pick it up (omarchy-restart-shell, then re-login)."
else
  echo "  Nothing was written. Re-run with --apply to install."
fi
